# Configure these on your host. Flask does not automatically load this file.
ARI_ENV=production
ARI_BIND=0.0.0.0
PORT=10000
ED_SALES_MODE=demo
ED_PUBLIC_PREVIEW=1
# Free preview: this path is ephemeral. For persistent hosting use a mounted disk.
ED_DATA_DIR=/tmp/ed-airline
# Set a random secret in the host dashboard, never commit its value.
ARI_SESSION_SECRET=
# Set to the final HTTPS address for email links if configuring mail later.
ARI_PUBLIC_URL=
